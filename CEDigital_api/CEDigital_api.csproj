<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Data\Sql\Tablas\**" />
    <Content Remove="Data\Sql\Tablas\**" />
    <EmbeddedResource Remove="Data\Sql\Tablas\**" />
    <None Remove="Data\Sql\Tablas\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Controllers\Sql\Queries\cursos_usuario.sql" />
    <None Remove="Controllers\Sql\Queries\notas_por_grupo.sql" />
    <None Remove="Controllers\Sql\Queries\noticias_usuario.sql" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Controllers\Sql\Queries\cursos_usuario.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Controllers\Sql\Queries\notas_por_grupo.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Controllers\Sql\Queries\noticias_usuario.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="EPPlus" Version="8.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MongoDB.Bson" Version="3.4.0" />
    <PackageReference Include="MongoDB.Driver" Version="3.4.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

</Project>
